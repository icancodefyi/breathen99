# --- Public (exposed to the browser) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Server only: never commit real values ---
MONGODB_URI=
MONGODB_DB=breathen99
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=


# --- Email (Resend). Optional: emails are skipped if unset ---
RESEND_API_KEY=
# e.g. "breathEN <orders@breathen99.com>" (domain must be verified in Resend)
EMAIL_FROM=
# Comma-separated founder emails that get a new-order alert
ORDER_ALERT_EMAILS=

# --- Admin orders page (/admin). Optional: admin is disabled if unset ---
# Strong password, 12+ characters
ADMIN_PASSWORD=
# Random string, 32+ characters (e.g. `openssl rand -base64 48`)
ADMIN_SESSION_SECRET=
